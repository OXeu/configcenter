{
  "name": "configcenter-web",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "npm run build:docs && vp build && node tools/compress-assets.ts",
    "lint": "node .tmp/common/tools/lint-files.ts && vp lint && node tools/lint-templates.ts",
    "fmt": "vp fmt",
    "test": "vp test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "typecheck": "node node_modules/typescript-native/bin/tsc -p tsconfig.native.json && vue-tsc -p tsconfig.json",
    "build:docs": "node tools/build-docs.ts"
  },
  "devDependencies": {
    "@oxeu/center-common": "file:.tmp/common",
    "@shikijs/transformers": "^4.6.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/devtools-api": "^8.2.1",
    "@vue/test-utils": "^2.6.0",
    "@yusufceng1z/ding": "^0.0.6",
    "jsdom": "^26.1.0",
    "markdown-it": "^15.0.3",
    "pinia": "^4.1.0",
    "postcss": "^8.5.33",
    "remixicon": "^4.9.1",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-native": "npm:typescript@^7.0.2",
    "vite-plus": "1.6.0",
    "vue": "^3.5.45",
    "vue-router": "^4.6.5",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vitest": "5.1.0"
  }
}
