{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vite-plus/client"],
    "allowImportingTsExtensions": true,
    "preserveSymlinks": true
  },
  "include": ["web/ui/src/**/*.ts", "web/ui/src/**/*.vue", "web/ui/__tests__/**/*.ts"]
}
